[Unit]
Description=Vigia de notas fiscais Sebrae (conta Rafael) - compara Consultar Nota Fiscal com o visto e avisa no WhatsApp
After=network-online.target postgresql.service docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/sebrae-os-vigia
EnvironmentFile=/opt/sebrae-os-vigia/.env
ExecStart=/usr/bin/node /opt/sebrae-os-vigia/vigia-nf.js
TimeoutStartSec=900
StandardOutput=append:/var/log/sebrae-nf-vigia.log
StandardError=append:/var/log/sebrae-nf-vigia.log
