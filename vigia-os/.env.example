# Copiar para /opt/sebrae-os-vigia/.env na KVM8 (chmod 600). Nenhum valor real aqui.
PG_URL=postgresql://apollo_fn:SENHA@localhost:5432/apollo
SCRAPER_URL=http://127.0.0.1:8001
EVO_URL=https://evolution.exemplo
EVO_KEY=chave-da-evolution
EVO_INSTANCE=claudinho
# Quem recebe o aviso de O.S. (DDI+DDD+numero, separados por virgula; o 1o tambem recebe alerta tecnico).
# Em producao: pessoal do Rafael + Geovana (decisao de 05/10/2026).
DESTINOS=55DDDNUMERO1,55DDDNUMERO2
# Pausa aleatoria entre um destino e outro (segundos), para poupar a instancia.
INTERVALO_MIN_S=30
INTERVALO_MAX_S=120
CONTA=rafael
JANELA_INICIO=0
JANELA_FIM=23
FALHAS_PARA_AVISAR=6
# Vigia de notas fiscais (vigia-nf.js, mesmo .env): janela propria em horas BRT.
NF_JANELA_INICIO=7
NF_JANELA_FIM=20
